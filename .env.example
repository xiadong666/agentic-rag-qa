# ============================================================
# RAG 知识库问答系统 —— 环境变量模板
# 复制为 .env 后按需修改；.env 不要提交到 git
# ============================================================

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 数据目录（默认项目下 data/，会自动创建）----------
DATA_DIR=./data

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=50
# 解析器支持 pdf/docx/txt/md/csv/json 等；这里要同步放开，否则会被 400 拦掉
# （困难语料 sample_docs/hard 里的 07_线上问题登记表.csv 就需要 csv）
ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv

# ---------- 分块参数（面向中文，按“字符”计）----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- Embedding：local = 本地 sentence-transformers（默认，免 key）----------
# openai = OpenAI 兼容接口（硅基流动/阿里百炼/智谱 等）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto            # auto | cpu | cuda
EMBEDDING_BATCH_SIZE=32
# openai 模式下使用（示例为硅基流动）：
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 检索 ----------
RETRIEVE_DENSE_K=12               # 稠密检索取回数
RETRIEVE_SPARSE_K=12              # 稀疏(BM25)取回数
RRF_CONSTANT=60                   # RRF 融合常数 k
RERANK_ENABLED=true
RERANK_MODEL=maidalun1020/bce-reranker-base_v1
RERANK_TOP_K=4                    # 最终送入 LLM 的片段数

# ---------- LLM（OpenAI 兼容；默认 DeepSeek）----------
# 把 sk-xxx 换成你自己的 key；.env 已在 .gitignore 中，不会被提交
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-请填入你的key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# ---------- 模型路由（AI 中台能力）----------
# 轻量模型用于规划/判定/改写/压缩等高频低价值任务；留空=与主模型相同
LLM_SMALL_MODEL=
# 强力模型用于决策备忘录等高价值输出；留空=与主模型相同
LLM_STRONG_MODEL=
# 任务 → 档位（small | default | strong）；档位未配置会自动向上回落
LLM_TASK_ROUTES=rewrite:small,answer:default,grade:small,verify:small,compress:small,memo:strong,agent:default

# ---------- Token 统计与成本（AI 中台能力）----------
# 单价：元 / 百万 token（按厂商官网价格填写，用于成本估算）
LLM_PRICE_INPUT_PER_M=1.0
LLM_PRICE_OUTPUT_PER_M=2.0

# ---------- 向量库后端（FAISS / Qdrant 双实现）----------
VECTOR_BACKEND=faiss
# 服务模式（推荐生产）：docker run -d -p 6333:6333 qdrant/qdrant
# QDRANT_URL=http://localhost:6333
# 本地模式（无需 Docker，数据落在项目目录）
# QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=dsh_rag

# ---------- 对话历史 ----------
HISTORY_MAX_TURNS=6               # 保留最近 N 轮（1 轮 = 一问一答）
QUERY_REWRITE=true                # 用历史把问题改写为“独立问题”后再检索

# ---------- Agentic RAG（Agent 编排）----------
# 总开关：false 时 /api/chat 走朴素 RAG 链路（可用于按场景路由与 A/B 对比）
AGENT_ENABLED=true
AGENT_MAX_RETRIEVAL_ROUNDS=3      # 最多几轮“检索→判定→改写”，控制延迟与成本上限
AGENT_RETRIEVE_TOP_K=5            # 单次检索召回条数（进证据池）
AGENT_GRADE_MIN_CONFIDENCE=1      # 判定置信度门槛（0~1，越高越容易再检一轮；默认 1=看 sufficient 即可）
AGENT_STRONG_SCORE=0.55           # 精排最高分 ≥ 它时提前收束（防止判定器偏严导致空转）
AGENT_SCORE_FLOOR_RATIO=0.55      # 分数下限保护：≥ 本批最高分×该系数的片段，即使被判“不相关”也保留
AGENT_VERIFY_ENABLED=true         # 生成后做忠实度自检（第二道防幻觉闸门）
AGENT_VERIFY_RETRY=0              # 预留：自检未通过的重生成次数（当前实现为"标注式"处理）
AGENT_REWRITE_N=2                 # 每次反思生成几条新检索式
AGENT_CONTEXT_MAX_CHARS=6000      # 证据进上下文的字符预算（超出按分数裁剪）
AGENT_COMPRESS_MIN_QUESTION_CHARS=30   # 问题多长才触发证据压缩（短问题不值得多调模型）

# ---------- HuggingFace（一般无需改动）----------
# 默认：模型纯离线加载（只读项目 data/hf 缓存，不联网、不被墙卡死）；
#       镜像站 https://hf-mirror.com 仅在你关闭离线模式下载新模型时使用。
# 需要下载/更换模型（如改成 bge-m3）时改为 false，并保证能访问镜像站：
# HF_HUB_OFFLINE=false
# 也可显式覆盖镜像与缓存目录：
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=./data/hf
